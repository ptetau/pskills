diff --git a/cart/discounts.py b/cart/discounts.py
new file mode 100644
index 0000000..b1c2d3e
--- /dev/null
+++ b/cart/discounts.py
@@ -0,0 +1,16 @@
+from decimal import Decimal
+from datetime import datetime
+
+CODES = {
+    "SAVE10": {"kind": "percent", "value": 10},
+    "TENOFF": {"kind": "fixed", "value": 10},
+}
+
+
+def apply_discount(amount, code):
+    c = CODES.get(code)
+    if not c:
+        return amount
+    off = amount * Decimal(c["value"]) / 100
+    return (amount - off).quantize(Decimal("0.01"))
+
