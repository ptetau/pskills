diff --git a/src/todo/app.clj b/src/todo/app.clj
index 38a2dd9..121541b 100644
--- a/src/todo/app.clj
+++ b/src/todo/app.clj
@@ -7,11 +7,12 @@
 
 (defn handle
   "Answers one request. The data file holds the items between requests."
-  [data-file {:keys [method path body]}]
+  [data-file {:keys [method path query body]}]
   (try
     (cond
       (and (= method "GET") (= path "/"))
-      (http/html 200 (page/render (store/load-items data-file)))
+      (http/html 200 (page/render (store/load-items data-file)
+                                  (some #{"show=all"} (str/split (or query "") #"&"))))
 
       (and (= method "POST") (= path "/items"))
       (let [text (str/trim (or (http/form-value body "text") ""))]
@@ -19,6 +20,12 @@
           (http/text 400 "error: text is empty")
           (do (store/add! data-file text) (http/redirect "/"))))
 
+      (and (= method "POST") (re-matches #"/items/[^/]+/done" path))
+      (let [id (second (re-matches #"/items/([^/]+)/done" path))]
+        (if (and (re-matches #"\d+" id) (store/mark-done! data-file (parse-long id)))
+          (http/redirect "/")
+          (http/text 404 (str "error: no item " id))))
+
       :else (http/text 404 "error: not found"))
     (catch java.io.IOException e
       (http/text 500 (str "error: " (.getMessage e))))))
diff --git a/src/todo/page.clj b/src/todo/page.clj
index 83d9fd1..45b5ee6 100644
--- a/src/todo/page.clj
+++ b/src/todo/page.clj
@@ -7,12 +7,20 @@
   [text]
   (str/escape text {\& "&amp;" \< "&lt;" \> "&gt;" \" "&quot;"}))
 
-(defn render [items]
+(defn render [items show-all]
+  (let [items (filter #(or show-all (not (:done %))) items)]
   (str "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>To-do</title></head>\n<body>\n"
        "<h1>To-do</h1>\n"
        (if (empty? items)
          "<p>Nothing to do.</p>\n"
-         (str "<ul>\n" (apply str (map #(str "<li>" (escape (:text %)) "</li>\n") items)) "</ul>\n"))
+         (str "<ul>\n"
+              (apply str (map #(if (:done %)
+                                 (str "<li>" (escape (:text %)) " (done)</li>\n")
+                                 (str "<li>" (escape (:text %)) " <form method=\"post\" action=\"/items/" (:id %)
+                                      "/done\"><button>Done</button></form></li>\n"))
+                              items))
+              "</ul>\n"))
        "<form method=\"post\" action=\"/items\">"
        "<input name=\"text\" aria-label=\"New item\"> <button>Add</button></form>\n"
-       "</body></html>\n"))
+       "<p><a href=\"/?show=all\">Show all</a></p>\n"
+       "</body></html>\n")))
diff --git a/src/todo/store.clj b/src/todo/store.clj
index 0cc0941..71ebdc6 100644
--- a/src/todo/store.clj
+++ b/src/todo/store.clj
@@ -6,9 +6,11 @@
             [clojure.string :as str]))
 
 (defn- parse-line [line]
-  (let [[id text] (str/split line #"\t" 2)]
-    (when (and text (re-matches #"\d+" id))
-      {:id (Long/parseLong id) :text text})))
+  (let [[id second text] (str/split line #"\t" 3)]
+    (when (and second (re-matches #"\d+" id))
+      (if text
+        {:id (Long/parseLong id) :text text :done (= second "done")}
+        {:id (Long/parseLong id) :text second :done false}))))
 
 (defn load-items
   "Each item, in the order in which it was added."
@@ -19,13 +21,21 @@
       [])))
 
 (defn- save! [path items]
-  (spit path (apply str (map #(str (:id %) "\t" (:text %) "\n") items))))
+  (spit path (apply str (map #(str (:id %) "\t" (if (:done %) "done" "open") "\t" (:text %) "\n") items))))
+
+(defn mark-done!
+  "Marks the item done. False when no item has the id."
+  [path id]
+  (let [items (load-items path)]
+    (if (some #(= id (:id %)) items)
+      (do (save! path (mapv #(if (= id (:id %)) (assoc % :done true) %) items)) true)
+      false)))
 
 (defn add!
   "Adds an item with the next free id. Tabs and line breaks in the text become spaces."
   [path text]
   (let [items (load-items path)
         id (inc (reduce max 0 (map :id items)))
-        item {:id id :text (str/replace text #"[\t\r\n]" " ")}]
+        item {:id id :text (str/replace text #"[\t\r\n]" " ") :done false}]
     (save! path (conj items item))
     item))
