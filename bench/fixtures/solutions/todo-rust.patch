diff --git a/src/lib.rs b/src/lib.rs
index 7a1dcb4..847a0b1 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -11,7 +11,7 @@ use store::Store;
 pub fn handle(store: &Store, request: &Request) -> Response {
     match (request.method.as_str(), request.path.as_str()) {
         ("GET", "/") => match store.load() {
-            Ok(items) => Response::html(200, page::render(&items)),
+            Ok(items) => Response::html(200, page::render(&items, request.query.split('&').any(|p| p == "show=all"))),
             Err(error) => Response::text(500, &format!("error: {}", error)),
         },
         ("POST", "/items") => {
@@ -25,6 +25,14 @@ pub fn handle(store: &Store, request: &Request) -> Response {
                 Err(error) => Response::text(500, &format!("error: {}", error)),
             }
         }
+        ("POST", path) if path.starts_with("/items/") && path.ends_with("/done") => {
+            let id = &path["/items/".len()..path.len() - "/done".len()];
+            match id.parse::<u64>().ok().map(|n| store.mark_done(n)) {
+                Some(Ok(true)) => Response::redirect("/"),
+                Some(Err(error)) => Response::text(500, &format!("error: {}", error)),
+                _ => Response::text(404, &format!("error: no item {}", id)),
+            }
+        }
         _ => Response::text(404, "error: not found"),
     }
 }
diff --git a/src/page.rs b/src/page.rs
index a615fe8..28611bc 100644
--- a/src/page.rs
+++ b/src/page.rs
@@ -2,17 +2,29 @@
 
 use crate::store::Item;
 
-pub fn render(items: &[Item]) -> String {
+pub fn render(items: &[Item], show_all: bool) -> String {
+    let items: Vec<&Item> = items.iter().filter(|item| show_all || !item.done).collect();
     let list = if items.is_empty() {
         "<p>Nothing to do.</p>\n".to_string()
     } else {
-        let rows: String = items.iter().map(|item| format!("<li>{}</li>\n", escape(&item.text))).collect();
+        let rows: String = items
+            .iter()
+            .map(|item| {
+                if item.done {
+                    format!("<li>{} (done)</li>\n", escape(&item.text))
+                } else {
+                    format!("<li>{} <form method=\"post\" action=\"/items/{}/done\"><button>Done</button></form></li>\n",
+                            escape(&item.text), item.id)
+                }
+            })
+            .collect();
         format!("<ul>\n{}</ul>\n", rows)
     };
     format!(
         "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>To-do</title></head>\n<body>\n\
          <h1>To-do</h1>\n{}<form method=\"post\" action=\"/items\">\
-         <input name=\"text\" aria-label=\"New item\"> <button>Add</button></form>\n</body></html>\n",
+         <input name=\"text\" aria-label=\"New item\"> <button>Add</button></form>\n\
+         <p><a href=\"/?show=all\">Show all</a></p>\n</body></html>\n",
         list
     )
 }
diff --git a/src/store.rs b/src/store.rs
index 2a82ee5..e100b62 100644
--- a/src/store.rs
+++ b/src/store.rs
@@ -10,6 +10,7 @@ use std::path::PathBuf;
 pub struct Item {
     pub id: u64,
     pub text: String,
+    pub done: bool,
 }
 
 pub struct Store {
@@ -31,8 +32,13 @@ impl Store {
         Ok(text
             .lines()
             .filter_map(|line| {
-                let (id, text) = line.split_once('\t')?;
-                Some(Item { id: id.parse().ok()?, text: text.to_string() })
+                let mut fields = line.splitn(3, '\t');
+                let id = fields.next()?.parse().ok()?;
+                let second = fields.next()?;
+                match fields.next() {
+                    Some(text) => Some(Item { id, text: text.to_string(), done: second == "done" }),
+                    None => Some(Item { id, text: second.to_string(), done: false }),
+                }
             })
             .collect())
     }
@@ -42,14 +48,26 @@ impl Store {
         let mut items = self.load()?;
         let id = items.iter().map(|item| item.id).max().unwrap_or(0) + 1;
         let text: String = text.chars().map(|c| if c == '\t' || c == '\n' || c == '\r' { ' ' } else { c }).collect();
-        let item = Item { id, text };
+        let item = Item { id, text, done: false };
         items.push(item.clone());
         self.save(&items)?;
         Ok(item)
     }
 
+    /// Marks the item done. False when no item has the id.
+    pub fn mark_done(&self, id: u64) -> io::Result<bool> {
+        let mut items = self.load()?;
+        let Some(item) = items.iter_mut().find(|item| item.id == id) else { return Ok(false) };
+        item.done = true;
+        self.save(&items)?;
+        Ok(true)
+    }
+
     fn save(&self, items: &[Item]) -> io::Result<()> {
-        let text: String = items.iter().map(|item| format!("{}\t{}\n", item.id, item.text)).collect();
+        let text: String = items
+            .iter()
+            .map(|item| format!("{}\t{}\t{}\n", item.id, if item.done { "done" } else { "open" }, item.text))
+            .collect();
         fs::write(&self.path, text)
     }
 }
