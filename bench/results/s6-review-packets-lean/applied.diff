+ACCEPTANCE = re.compile(r"^\s*-\s+Given\b")
+
+
+def without_copied_lines(text, change):
+    """A requirement's text without the acceptance lines that the change spec already shows.
+    The lines stay when the change spec lacks any of them, so a reviewer always sees each line."""
+    lines = text.splitlines()
+    copied = [line for line in lines if ACCEPTANCE.match(line)]
+    if not copied or not all(line.strip() in change for line in copied):
+        return text
+    kept = [line for line in lines if not ACCEPTANCE.match(line)]
+    kept.append("- The acceptance lines of this requirement are in the change spec above.")
+    return re.sub(r"\n{3,}", "\n\n", "\n".join(kept)).strip()
+
+
