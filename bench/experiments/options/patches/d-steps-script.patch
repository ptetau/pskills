+#!/usr/bin/env python3
+"""pdlc steps. Does the fixed sequence of a stage in one call.
+
+Usage, from the project root:
+  python3 pdlc/bin/steps.py lock IN-0001                    lock the acceptance checks
+  python3 pdlc/bin/steps.py lock CH-0001                    lock the checks of a change
+  python3 pdlc/bin/steps.py checks CH-0001                  run the checks that verify needs
+  python3 pdlc/bin/steps.py verified CH-0001 [PASS_COMMIT]  record a passed verify round
+
+lock runs after the red run. It does these steps:
+  - Commits all changes as "Acceptance IN-xxxx" or "Tests CH-xxxx". The trailers are
+    Intent, Change (on the branch of a change), and Req.
+  - Writes the hash of that commit on the last "Acceptance-Locked:" or "Tests-Locked:" line.
+    Commits the line as "Lock acceptance IN-xxxx" or "Lock tests CH-xxxx".
+  - Runs make_packets.py for the tests packet.
+  - Runs check_writing.py on the text that the two commits wrote. The commit hook does not
+    see a commit that a script makes, so this script runs the check.
+The files outside pdlc/ must be check files. If not, lock commits nothing.
+
+checks runs these items, in this order. Each run has a time limit of 300 s.
+  - all.
+  - one requirement, for each requirement that is not "(retire)".
+  - earlier acceptance, and the acceptance of this intent.
+  - A diff of the check files against their locks.
+It prints one line for each item, the pass commit, and the verdict. The acceptance run of a
+change before the last one is expected to fail. Exit code 0 means that each required item
+passes.
+
+verified runs after the reviewers passed. It does these steps:
+  - Sets "Status: verified" on each requirement of the change that is not "(retire)".
+  - Sets the change to "in review".
+  - For the last change, writes the pass commit on "Acceptance-Passed:".
+  - Sets the intent to "in review" when each other change is "in review" or "merged".
+  - Commits all as "Verified CH-xxxx", with the trailers Intent and Change.
+It refuses when a remit has no passed result, or when the last change gets no pass commit.
+
+Each refusal prints one line, commits nothing, and exits with code 1.
+"""
+import importlib.util
+import os
+import re
+import shlex
+import signal
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+LIMIT = 300  # seconds for one check run
+# The text that the stages write, as the commit hook reads it. The review folders hold
+# packets and results, so they stay out.
+WRITTEN = re.compile(r"^pdlc/(?:specs|inbox|changes)/(?!.*/review/).*\.md$")
+# How a test runner reports its count: unittest, TAP (node --test), and pytest.
+COUNTS = [r"^Ran (\d+) tests?\b", r"^[#\u2139]\s*pass (\d+)\b", r"\b(\d+) passed\b"]
+CHECK_FOLDERS = ["test", "tests", "spec", "__tests__"]
+REQ_ID = r"\b(?:JOB|CAP|DES)-[a-z0-9-]+\.R\d+\b"
+USAGE = ("Usage: steps.py lock IN-0001|CH-0001, steps.py checks CH-0001, "
+         "or steps.py verified CH-0001 [PASS_COMMIT]")
+
+
+def load(name):
+    """A script of this folder as a module."""
+    spec = importlib.util.spec_from_file_location(name, HERE / (name + ".py"))
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+merge = load("check_merge")
+packets = load("make_packets")
+records = load("record_merges")
+
+
+class Refused(Exception):
+    """A step stops before it changes anything. The message is the one line to print."""
+
+
+def out(root, *args):
+    """The output of a git command. A failed command refuses."""
+    done = merge.git(root, *args)
+    if done.returncode:
+        why = (done.stderr or done.stdout).strip().splitlines()
+        raise Refused("git failed: %s" % (why[0] if why else "no message"))
+    return done.stdout.strip()
+
+
+def count_of(number, word):
+    return "%d %s%s" % (number, word, "" if number == 1 else "s")
+
+
+def lines(root, *args):
+    return out(root, "-c", "core.quotePath=false", *args).splitlines()
+
+
+def find(root, target):
+    """(path, text) of the intent or the change spec that the ID names."""
+    if target.startswith("IN-"):
+        found, what = sorted((root / "pdlc" / "inbox").glob(target + "-*.md")), "intent"
+    else:
+        found = sorted((root / "pdlc" / "changes").glob(target + "-*/change.md"))
+        what = "change spec"
+    if not found:
+        raise Refused("No %s found for %s" % (what, target))
+    return found[0], found[0].read_text()
+
+
+def intent_of(root, text):
+    """(ID, path, text) of the intent that a change spec names."""
+    intent = merge.field(text, "Intent")
+    if not intent or not intent.startswith("IN-"):
+        raise Refused("The change spec names no intent.")
+    return (intent, *find(root, intent))
+
+
+def branch_owner(root):
+    """(branch, ID, text) of the change or intent whose Branch: is the current branch. The
+    ID and the text are None when no spec names the branch."""
+    here = out(root, "rev-parse", "--abbrev-ref", "HEAD")
+    for pattern in ("changes/CH-*/change.md", "inbox/IN-*.md"):
+        for path in sorted((root / "pdlc").glob(pattern)):
+            text = path.read_text()
+            if merge.field(text, "Branch") == here:
+                folder = path.parent if path.name == "change.md" else path
+                return here, merge.change_id(folder), text
+    return here, None, None
+
+
+def changed_paths(root):
+    """(changed, deleted): the paths that differ from HEAD, and the ones that are gone."""
+    changed = lines(root, "diff", "--name-only", "--no-renames", "HEAD")
+    changed += lines(root, "ls-files", "--others", "--exclude-standard")
+    deleted = lines(root, "diff", "--name-only", "--no-renames", "--diff-filter=D", "HEAD")
+    return list(dict.fromkeys(changed)), set(deleted)
+
+
+def check_folders(root):
+    config = (root / "pdlc" / "config.md").read_text()
+    line = re.search(r"^- check folders:\s*(.+)$", config, re.M)
+    names = re.findall(r"`([^`]+)`", line.group(1)) if line else []
+    return [name.strip("/") for name in names] or CHECK_FOLDERS
+
+
+def under(path, places):
+    return any(path == place or path.startswith(place.rstrip("/") + "/") for place in places)
+
+
+def read(path):
+    """The text of a file, or "" when the file is not there."""
+    return path.read_text() if path.exists() else ""
+
+
+def last_change(intent_text):
+    """The last change under "Changes" in an intent, or None when it lists none."""
+    listed = re.findall(r"\bCH-\d+\b", merge.section(intent_text, "Changes"))
+    return listed[-1] if listed else None
+
+
+def set_record(text, name, value, title=None):
+    """The text with the last "<name>:" line set to the value. With a title, the line is
+    the last one in that "## " section. None when the text has no such line."""
+    body = merge.section(text, title) if title else text
+    found = list(re.finditer(r"^%s:.*$" % re.escape(name), body, re.M))
+    if not found:
+        return None
+    new = body[:found[-1].start()] + "%s: %s" % (name, value) + body[found[-1].end():]
+    return text.replace(body, new, 1) if title else new
+
+
+def commit(root, subject, intent, change=None, reqs=()):
+    """Commit the staged files, with the trailers of DES-pdlc-commit-trailers. Gives the
+    short hash of the new commit."""
+    trailers = ["Intent: " + intent]
+    if change:
+        trailers.append("Change: " + change)
+    if reqs:
+        trailers.append("Req: " + ", ".join(reqs))
+    out(root, "commit", "-q", "-m", subject + "\n\n" + "\n".join(trailers))
+    return out(root, "rev-parse", "--short", "HEAD")
+
+
+def writing_findings(root, first):
+    """The findings of check_writing.py in the text that the commits since first wrote."""
+    files = [f for f in lines(root, "diff", "--name-only", first + "~1", "HEAD")
+             if WRITTEN.match(f) and (root / f).is_file()]
+    if not files:
+        return []
+    done = subprocess.run([sys.executable, str(HERE / "check_writing.py"), "--since",
+                           first + "~1", *files], cwd=root, capture_output=True, text=True)
+    return [line for line in done.stdout.splitlines() if " \u00b7 " in line]
+
+
+def lock(root, target):
+    path, text = find(root, target)
+    changed, deleted = changed_paths(root)
+    branch, owner, owner_text = branch_owner(root)
+    if target.startswith("IN-"):
+        name, title, intent = "Acceptance-Locked", "Acceptance checks", target
+        packet_args = [target]
+        subjects = ("Acceptance " + target, "Lock acceptance " + target)
+        reqs = list(dict.fromkeys(re.findall(REQ_ID, merge.section(text, "Requirements"))))
+        wanted = merge.record(text, "Acceptance-File")
+        if not wanted or wanted == "none":
+            raise Refused("%s names no Acceptance-File. Write it in the intent first." % target)
+        pattern = packets.acceptance_file(root)
+        mine = owner == target or bool(owner and owner.startswith("CH-")
+                                       and merge.field(owner_text, "Intent") == target)
+
+        def is_check(p):
+            return p == wanted or packets.is_acceptance(p, pattern)
+    else:
+        name, title, packet_args = "Tests-Locked", None, [target, "tests"]
+        subjects = ("Tests " + target, "Lock tests " + target)
+        intent = intent_of(root, text)[0]
+        reqs = [rid for rid, _ in merge.REQ.findall(merge.section(text, "Requirements"))]
+        listed, folders = merge.check_files(text), check_folders(root)
+        mine = owner == target
+
+        def is_check(p):
+            return under(p, listed) or (p in deleted and under(p, folders))
+    if not reqs:
+        raise Refused("%s lists no requirements." % target)
+    if set_record(text, name, "x", title) is None:
+        raise Refused("%s has no %s line." % (target, name))
+    if not mine:
+        raise Refused("You are on %s. That is not a branch of %s. Switch to its branch first."
+                      % (branch, target))
+    change = owner if owner.startswith("CH-") else None
+
+    outside = [p for p in changed if not p.startswith("pdlc/")]
+    for other in outside:
+        if not is_check(other):
+            raise Refused("%s is not a check file and not under pdlc/. Commit or delete it first."
+                          % other)
+    if not outside:
+        raise Refused("No check file changed. Write the checks first.")
+
+    out(root, "add", "-A")
+    first = commit(root, subjects[0], intent, change, reqs)
+    path.write_text(set_record(text, name, first, title))
+    out(root, "add", str(path.relative_to(root)))
+    commit(root, subjects[1], intent, change)
+    print("%s: %s (%s)" % (subjects[0], first, count_of(len(outside), "check file")))
+    print("%s: %s: %s" % (subjects[1], name, first))
+
+    code = packets.main(["make_packets.py", *packet_args], root)
+    found = writing_findings(root, first)
+    if found:
+        print("writing: " + count_of(len(found), "finding"))
+        for line in found:
+            print("  " + line)
+        print("Fix all of them in one edit, in the next commit of this stage.")
+    else:
+        print("writing: none")
+    return code
+
+
+def command(root, name):
+    """The command on the line "- <name>: `...`" in the Checks section of config.md, or None."""
+    config = (root / "pdlc" / "config.md").read_text()
+    line = re.search(r"^- %s:\s*`([^`]+)`" % re.escape(name), merge.section(config, "Checks"), re.M)
+    return line.group(1) if line else None
+
+
+def run(root, shell_command):
+    """(ok, note, last lines) of one check run. A count of 0 is a failure."""
+    proc = subprocess.Popen(shell_command, shell=True, cwd=root, stdout=subprocess.PIPE,
+                            stderr=subprocess.STDOUT, encoding="utf-8", errors="replace",
+                            start_new_session=True)
+    try:
+        text = proc.communicate(timeout=LIMIT)[0]
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except OSError:
+            proc.kill()
+        return False, "timed out after %d s" % LIMIT, proc.communicate()[0].splitlines()[-15:]
+    tail = text.splitlines()[-15:]
+    found = [re.findall(p, text, re.M) for p in COUNTS]
+    count = next((int(f[-1]) for f in found if f), None)
+    if proc.returncode:
+        return False, "exit code %d" % proc.returncode, tail
+    if count == 0:
+        return False, "no checks found", tail
+    return True, "count unknown" if count is None else count_of(count, "check"), tail
+
+
+def with_files(shell_command, files):
+    return shell_command.replace("{files}", " ".join(shlex.quote(f) for f in files))
+
+
+def checks(root, target):
+    if not target.startswith("CH-"):
+        raise Refused("checks needs a change ID, for example CH-0001.")
+    path, text = find(root, target)
+    intent, intent_path, intent_text = intent_of(root, text)
+    is_last = last_change(intent_text) in (None, target)
+    reqs = merge.REQ.findall(merge.section(text, "Requirements"))
+    config = (root / "pdlc" / "config.md").read_text()
+    form = re.search(r"^- ID form in check names:\s*`?(\w+)", config, re.M)
+    accept = command(root, "acceptance")
+    items = []  # (label, required, ok, note, last lines)
+
+    def add(label, ok, note, required=True, tail=()):
+        items.append((label, required, ok, note, [] if ok else list(tail)))
+
+    def run_item(label, shell_command, required=True):
+        ok, note, tail = (run(root, shell_command) if shell_command
+                          else (False, "pdlc/config.md has no such command", []))
+        add(label, ok, note, required, tail)
+
+    def unchanged(label, lock, files):
+        """An item that passes when no file changed since the lock."""
+        if not files:
+            return add(label, True, "no check files")
+        if not merge.HASH.match(lock or ""):
+            return add(label, False, "no lock hash")
+        diff = merge.git(root, "diff", "--name-only", lock, "--", *files)
+        if diff.returncode:
+            return add(label, False, "can't compare with the lock %s" % lock)
+        names = diff.stdout.split()
+        add(label, not names, "changed: " + ", ".join(names) if names else "lock %s" % lock)
+
+    run_item("all", command(root, "all"))
+    one = command(root, "one requirement")
+    for rid, rest in reqs:
+        if "(retire)" not in rest:
+            shown = re.sub(r"[-.]", "_", rid) if form and form.group(1) == "underscored" else rid
+            run_item("one requirement " + rid, one and one.replace("{req}", shown))
+    earlier = []
+    for other in sorted((root / "pdlc" / "inbox").glob("IN-*.md")):
+        theirs = other.read_text()
+        passed = merge.record(theirs, "Acceptance-Passed") or ""
+        if other != intent_path and merge.HASH.match(passed):
+            earlier.append(merge.record(theirs, "Acceptance-File"))
+    if earlier:
+        run_item("earlier acceptance", accept and with_files(accept, earlier))
+    else:
+        add("earlier acceptance", True, "none")
+    file = merge.record(intent_text, "Acceptance-File")
+    lock = merge.record(intent_text, "Acceptance-Locked")
+    locked = file not in (None, "none") and bool(merge.HASH.match(lock or ""))
+    if locked:
+        run_item("acceptance " + intent, accept and with_files(accept, [file]), is_last)
+    elif reqs and all("(retire)" in rest for _, rest in reqs):
+        add("acceptance " + intent, True, "none, because the change only retires requirements")
+    else:
+        add("acceptance " + intent, False, "no locked acceptance checks")
+    tests = re.findall(r"^Tests-Locked:\s*([0-9a-f]{7,40})\b", text, re.M)
+    unchanged("check files since the tests lock", tests[-1] if tests else None,
+              merge.check_files(text))
+    if locked:
+        unchanged("acceptance file since its lock", lock, [file])
+
+    for label, required, ok, note, _ in items:
+        verdict = "pass" if ok else "FAIL" if required else "fail, expected before the last change"
+        print("%s: %s (%s)" % (label, verdict, note))
+    for label, required, ok, _, tail in items:
+        if required and not ok and tail:
+            print("Last lines of %s:" % label)
+            print("\n".join("  " + line for line in tail))
+    failed = sum(1 for _, required, ok, _, _ in items if required and not ok)
+    print("pass commit: " + out(root, "rev-parse", "--short", "HEAD"))
+    print("all required items pass" if not failed else
+          "%d required item%s" % (failed, " fails" if failed == 1 else "s fail"))
+    return 1 if failed else 0
+
+
+def verified(root, target, passed=None):
+    if not target.startswith("CH-"):
+        raise Refused("verified needs a change ID, for example CH-0001.")
+    path, text = find(root, target)
+    intent, intent_path, intent_text = intent_of(root, text)
+    branch, owner, _ = branch_owner(root)
+    if owner != target:
+        raise Refused("You are on %s. That is not the branch of %s. Switch to it first."
+                      % (branch, target))
+    outside = [p for p in changed_paths(root)[0] if not p.startswith("pdlc/")]
+    if outside:
+        raise Refused("%s is outside pdlc/. Commit or delete it first." % outside[0])
+    unpassed = [remit for remit in merge.remits(root)
+                if not re.match(r"\s*Result:\s*pass\b",
+                                read(path.parent / "review" / remit / "result.md"), re.I)]
+    if unpassed:
+        raise Refused("These remits have no passed result: %s." % ", ".join(unpassed))
+
+    lock = merge.record(intent_text, "Acceptance-Locked") or ""
+    needs = last_change(intent_text) in (None, target) and bool(merge.HASH.match(lock))
+    if needs:
+        if not passed:
+            raise Refused("%s is the last change of %s. Give the pass commit that checks printed."
+                          % (target, intent))
+        full = merge.git(root, "rev-parse", "--verify", "-q", passed + "^{commit}").stdout.strip()
+        if not full or not merge.is_ancestor(root, full, "HEAD"):
+            raise Refused("%s is not a commit on this branch." % passed)
+        passed = out(root, "rev-parse", "--short", full)
+
+    specs, done = {}, []
+    for rid, rest in merge.REQ.findall(merge.section(text, "Requirements")):
+        if "(retire)" in rest:
+            continue
+        spec = packets.spec_file(root, rid.rsplit(".", 1)[0])
+        body = specs.get(spec) or read(spec)
+        head = re.search(r"^### %s\b.*$" % re.escape(rid), body, re.M)
+        if not head:
+            raise Refused("%s is not in its spec." % rid)
+        end = re.search(r"^##", body[head.end():], re.M)
+        stop = head.end() + end.start() if end else len(body)
+        if not re.search(r"^Status:", body[head.end():stop], re.M):
+            raise Refused("%s has no Status line." % rid)
+        specs[spec] = (body[:head.end()] + records.with_status(body[head.end():stop], "verified")
+                       + body[stop:])
+        done.append(rid)
+
+    new_intent = intent_text
+    if needs:
+        new_intent = set_record(new_intent, "Acceptance-Passed", passed, "Acceptance checks")
+        if new_intent is None:
+            raise Refused("%s has no Acceptance-Passed line." % intent)
+    ready = not merge.partners_not_ready(root, path.parent, text)
+    if ready:
+        new_intent = records.with_status(new_intent, "in review")
+    for spec, body in specs.items():
+        spec.write_text(body)
+    path.write_text(records.with_status(text, "in review"))
+    intent_path.write_text(new_intent)
+    out(root, "add", "-A")
+    sha = commit(root, "Verified " + target, intent, target)
+    for rid in done:
+        print("%s: verified" % rid)
+    print("%s: in review" % target)
+    print("%s: %s" % (intent, "in review" if ready else "not changed, a change is not ready"))
+    if needs:
+        print("Acceptance-Passed: " + passed)
+    print("Verified %s: %s" % (target, sha))
+    return 0
+
+
+STEPS = {"lock": lock, "checks": checks, "verified": verified}
+
+
+def main(argv, root=Path(".")):
+    args = argv[1:]
+    if args[:1] in (["-h"], ["--help"]):
+        print(__doc__)
+        return 0
+    if (len(args) < 2 or args[0] not in STEPS or not re.fullmatch(r"(?:IN|CH)-\d+", args[1])
+            or len(args) > (3 if args[0] == "verified" else 2)):
+        print(USAGE)
+        return 1
+    try:
+        return STEPS[args[0]](Path(root), *args[1:])
+    except Refused as why:
+        print(why)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
