@@ -0,0 +1,190 @@
+"""Tests for the pdlc:stage agent and the ship skill. Run: python3 -m unittest discover plugins/pdlc/tests"""
+import re
+import unittest
+from pathlib import Path
+
+PLUGIN = Path(__file__).parent.parent
+AGENT = PLUGIN / "agents/stage.md"
+SKILLS = PLUGIN / "skills"
+SHIP = SKILLS / "ship/SKILL.md"
+README = SKILLS / "init/references/templates/README.md"
+HANDOFF = SKILLS / "init/references/templates/handoff.md"
+STAGES = ["intake", "ready", "change", "acceptance", "tests", "build", "show", "verify"]
+MODEL_RULE = "pdlc needs a Sonnet 5.5 class model or above."
+
+
+def split(path):
+    """(front matter keys, body) of a Markdown file with front matter."""
+    text = path.read_text()
+    head, body = re.match(r"---\n(.*?)\n---\n(.*)", text, re.S).groups()
+    keys = dict(re.findall(r"^([a-z-]+):[ \t]*(.*)$", head, re.M))
+    return keys, body
+
+
+def section(text, heading):
+    """The text under a "## heading" line, up to the next "## " line."""
+    return text.split("## %s\n" % heading, 1)[1].split("\n## ", 1)[0]
+
+
+class StageAgent(unittest.TestCase):
+    def test_the_front_matter_names_the_agent_and_lets_it_inherit_the_model(self):
+        keys, _ = split(AGENT)
+        self.assertEqual(keys["name"], "stage")
+        self.assertEqual(keys["model"], "inherit")
+        self.assertIn("description", keys)
+
+    def test_the_description_says_what_the_agent_does(self):
+        text = AGENT.read_text()
+        description = re.search(r"^description: >\n((?:  .*\n)+)", text, re.M).group(1)
+        flat = " ".join(description.split())
+        self.assertIn("Runs one pdlc stage for /pdlc:ship in a new context", flat)
+        self.assertIn("Reads all its inputs from the files of the project.", flat)
+
+    def test_the_agent_has_no_tools_line_so_that_it_can_start_agents(self):
+        keys, _ = split(AGENT)
+        self.assertNotIn("tools", keys)
+
+    def test_every_agent_starts_with_the_model_rule(self):
+        for path in sorted((PLUGIN / "agents").glob("*.md")):
+            with self.subTest(agent=path.name):
+                keys, body = split(path)
+                self.assertEqual(keys["model"], "inherit")
+                self.assertTrue(body.lstrip().startswith(MODEL_RULE))
+
+    def test_the_body_names_the_four_prompt_lines(self):
+        _, body = split(AGENT)
+        for line in ("Project root:", "Stage:", "Skill file:", "Work:"):
+            with self.subTest(line=line):
+                self.assertIn("- `%s`" % line, body)
+
+    def test_the_body_gives_the_five_lines_of_the_reply(self):
+        _, body = split(AGENT)
+        reply = body.split("```", 2)[1]
+        self.assertEqual([line.split(":")[0] for line in reply.strip().splitlines()],
+                         ["Stage", "Handoff", "Next", "Commit", "Stop"])
+        for word in ("`done`", "`sent back to <stage>`", "`stopped`"):
+            self.assertIn(word, body)
+
+    def test_the_agent_asks_nothing_and_runs_only_its_stage(self):
+        _, body = split(AGENT)
+        flat = " ".join(body.split())
+        self.assertIn("with `defaults`", flat)
+        self.assertIn("Ask the user nothing.", flat)
+        self.assertIn("Run only this stage.", flat)
+        self.assertIn("a contradiction between requirements", flat)
+        self.assertIn('a file that the change needs outside its "Files"', flat)
+
+    def test_the_agent_takes_the_answer_of_an_earlier_stop_from_the_newest_handoff(self):
+        _, body = split(AGENT)
+        flat = " ".join(body.split())
+        self.assertIn('"Open" section of the latest handoff', flat)
+        self.assertIn("recommended answer", flat)
+
+
+class ShipUsesTheAgent(unittest.TestCase):
+    def setUp(self):
+        self.ship = SHIP.read_text()
+        self.flat = " ".join(self.ship.split())
+
+    def test_ship_starts_each_stage_in_a_new_stage_agent(self):
+        self.assertIn("Each stage runs in a new `pdlc:stage` agent", self.flat)
+
+    def test_ship_gives_the_four_prompt_lines_and_nothing_else(self):
+        self.assertIn("these four lines and nothing else", self.flat)
+        for line in ("Project root: <absolute path>",
+                     "Stage: <stage>",
+                     "Skill file: ${CLAUDE_SKILL_DIR}/../<stage>/SKILL.md",
+                     "Work: <the ID, or for intake the words of the user, exactly>"):
+            with self.subTest(line=line):
+                self.assertIn("`%s`" % line, self.ship)
+
+    def test_the_prompt_lines_are_the_lines_that_the_agent_reads(self):
+        _, body = split(AGENT)
+        for line in ("Project root:", "Stage:", "Skill file:", "Work:"):
+            self.assertIn("`%s " % line, self.ship)
+            self.assertIn("- `%s`" % line, body)
