index 0000000..280f47c
--- /dev/null
+++ b/tests/test_JOB_report_word_frequencies.py
@@ -0,0 +1,148 @@
+import io
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from wordfreq.cli import main
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+USAGE = "usage: wordfreq FILE\n"
+TOP_ERROR = "error: --top needs a whole number greater than zero\n"
+TEXT = "the cat and the hat and the bat"
+
+
+def run_main(argv):
+    out, err = io.StringIO(), io.StringIO()
+    code = main(argv, stdout=out, stderr=err)
+    return code, out.getvalue(), err.getvalue()
+
+
+def run_command(argv):
+    proc = subprocess.run(
+        [sys.executable, "-m", "wordfreq"] + argv,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=30,
+    )
+    return proc.returncode, proc.stdout, proc.stderr
+
+
+class FileCase(unittest.TestCase):
+    def make_file(self, text):
+        d = tempfile.TemporaryDirectory()
+        self.addCleanup(d.cleanup)
+        path = os.path.join(d.name, "in.txt")
+        with open(path, "w") as f:
+            f.write(text)
+        return path
+
+
+class JOB_report_word_frequencies_R4(FileCase):
+    def assert_usage(self, result):
+        code, out, err = result
+        self.assertEqual(err, USAGE)
+        self.assertEqual(out, "")
+        self.assertEqual(code, 2)
+
+    def test_JOB_report_word_frequencies_R4_no_arguments(self):
+        self.assert_usage(run_main([]))
+
+    def test_JOB_report_word_frequencies_R4_two_files(self):
+        self.assert_usage(run_main(["a.txt", "b.txt"]))
+
+    def test_JOB_report_word_frequencies_R4_only_the_option(self):
+        self.assert_usage(run_main(["--top", "3"]))
+
+    def test_JOB_report_word_frequencies_R4_command_only_the_option(self):
+        self.assert_usage(run_command(["--top", "3"]))
+
+    def test_JOB_report_word_frequencies_R4_command_no_arguments(self):
+        self.assert_usage(run_command([]))
+
+
+class JOB_report_word_frequencies_R6(FileCase):
+    def check_top(self, argv_fn, expected):
+        path = self.make_file(TEXT)
+        code, out, err = run_main(argv_fn(path))
+        self.assertEqual(out, expected)
+        self.assertEqual(err, "")
+        self.assertEqual(code, 0)
+
+    def test_JOB_report_word_frequencies_R6_top_2(self):
+        self.check_top(lambda p: ["--top", "2", p], "the 3\nand 2\n")
+
+    def test_JOB_report_word_frequencies_R6_option_after_file(self):
+        self.check_top(lambda p: [p, "--top", "1"], "the 3\n")
+
+    def test_JOB_report_word_frequencies_R6_top_4_cuts_a_tie(self):
+        self.check_top(lambda p: ["--top", "4", p], "the 3\nand 2\nbat 1\ncat 1\n")
+
+    def test_JOB_report_word_frequencies_R6_top_equals_word_count(self):
+        self.check_top(
+            lambda p: ["--top", "5", p], "the 3\nand 2\nbat 1\ncat 1\nhat 1\n"
+        )
+
+    def test_JOB_report_word_frequencies_R6_top_above_word_count(self):
+        self.check_top(
+            lambda p: ["--top", "99", p], "the 3\nand 2\nbat 1\ncat 1\nhat 1\n"
+        )
+
+    def test_JOB_report_word_frequencies_R6_leading_zero(self):
+        self.check_top(lambda p: ["--top", "03", p], "the 3\nand 2\nbat 1\n")
+
+    def test_JOB_report_word_frequencies_R6_empty_file(self):
+        path = self.make_file("")
+        code, out, err = run_main(["--top", "3", path])
+        self.assertEqual(out, "")
+        self.assertEqual(code, 0)
+
+    def assert_top_error(self, argv):
+        code, out, err = run_main(argv)
+        self.assertEqual(err, TOP_ERROR, argv)
+        self.assertEqual(out, "", argv)
+        self.assertEqual(code, 2, argv)
+
+    def test_JOB_report_word_frequencies_R6_zero_is_an_error(self):
+        path = self.make_file("")
+        self.assert_top_error(["--top", "0", path])
+
+    def test_JOB_report_word_frequencies_R6_invalid_values_are_errors(self):
+        path = self.make_file("")
+        for bad in ["-1", "2.5", "abc", "1e2", "+3", ""]:
+            with self.subTest(n=bad):
+                self.assert_top_error(["--top", bad, path])
+
+    def test_JOB_report_word_frequencies_R6_option_without_value(self):
+        path = self.make_file("")
+        self.assert_top_error([path, "--top"])
+
+    def test_JOB_report_word_frequencies_R6_invalid_top_before_missing_file(self):
+        code, out, err = run_main(["--top", "0", "/no/such/file.txt"])
+        self.assertEqual(err, TOP_ERROR)
+        self.assertEqual(code, 2)
+
+    def test_JOB_report_word_frequencies_R6_valid_top_missing_file(self):
+        code, out, err = run_main(["--top", "2", "/no/such/file.txt"])
+        self.assertEqual(err, "error: cannot read /no/such/file.txt\n")
+        self.assertEqual(code, 2)
+
+    def test_JOB_report_word_frequencies_R6_command_top_2(self):
+        path = self.make_file(TEXT)
+        code, out, err = run_command(["--top", "2", path])
+        self.assertEqual(out, "the 3\nand 2\n")
+        self.assertEqual(err, "")
+        self.assertEqual(code, 0)
+
+    def test_JOB_report_word_frequencies_R6_command_invalid_top_exit_code(self):
+        path = self.make_file(TEXT)
+        code, out, err = run_command(["--top", "0", path])
+        self.assertEqual(err, TOP_ERROR)
+        self.assertEqual(out, "")
+        self.assertEqual(code, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
